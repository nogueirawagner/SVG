@model SVG.App.ViewModels.ImpedimentoOperadorViewModel

@using SVG.Domain.TiposEstruturados.TiposOperador
@using Microsoft.AspNetCore.Mvc.Rendering
@using SVG.Utilities.ExtensionsMethods

@{
    ViewData["Title"] = "Novo Impedimento";

    var operadores =
        ViewBag.Operadores as IEnumerable<SelectListItem>;
}

<div class="container mt-4"
     style="max-width: 850px;">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">
                Novo Impedimento
            </h3>

            <small class="text-muted">
                Informe o operador, o tipo e a vigência do impedimento.
            </small>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- OPERADOR -->

                <div class="mb-3">

                    <label asp-for="OperadorID" class="form-label"></label>

                    <input asp-for="OperadorID" type="hidden" id="operadorID" />

                    <div class="position-relative">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="pesquisaOperador"
                                   class="form-control"
                                   placeholder="Digite o nome ou numérica do operador..."
                                   autocomplete="off" />

                            <button type="button"
                                    id="limparOperador"
                                    class="btn btn-outline-secondary d-none"
                                    title="Limpar operador">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div id="listaOperadores"
                             class="list-group position-absolute w-100 shadow d-none"
                             style="z-index: 1050; max-height: 280px; overflow-y: auto; top: 100%; left: 0;">

                            @foreach (var operador in operadores)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action operador-item"
                                        data-id="@operador.Value"
                                        data-nome="@operador.Text">
                                    <i class="bi bi-person me-2 text-muted"></i>
                                    @operador.Text
                                </button>
                            }

                            <div id="nenhumOperador"
                                 class="list-group-item text-muted d-none">
                                Nenhum operador encontrado.
                            </div>
                        </div>
                    </div>

                    <span asp-validation-for="OperadorID" class="text-danger"></span>

                </div>

                <!-- TIPO -->

                <div class="mb-3">

                    <label asp-for="TipoImpedimento"
                           class="form-label">
                    </label>

                    <select asp-for="TipoImpedimento"
                            class="form-select">

                        <option value="">
                            Selecione o tipo de impedimento
                        </option>

                        @foreach (XTipoImpedimentoOperador tipo
                                                in Enum.GetValues(typeof(XTipoImpedimentoOperador)))
                        {
                            <option value="@((int)tipo)">
                                @tipo.GetDescription()
                            </option>
                        }

                    </select>

                    <span asp-validation-for="TipoImpedimento"
                          class="text-danger">
                    </span>

                </div>


                <!-- DATAS -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="DataInicio"
                               class="form-label">
                        </label>

                        <input asp-for="DataInicio"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DataInicio"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DataFim"
                               class="form-label">
                        </label>

                        <input asp-for="DataFim"
                               type="date"
                               class="form-control" />

                        <div class="form-text">
                            Deixe em branco quando o impedimento não tiver data final definida.
                        </div>

                        <span asp-validation-for="DataFim"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- OBSERVAÇÃO -->

                <div class="mb-4">

                    <label asp-for="Observacao"
                           class="form-label">
                    </label>

                    <textarea asp-for="Observacao"
                              class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="Informações adicionais sobre o impedimento...">
                    </textarea>

                    <span asp-validation-for="Observacao"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Salvar impedimento

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const pesquisa = document.getElementById("pesquisaOperador");
            const operadorID = document.getElementById("operadorID");
            const lista = document.getElementById("listaOperadores");
            const limpar = document.getElementById("limparOperador");
            const nenhumOperador = document.getElementById("nenhumOperador");
            const operadores = Array.from(document.querySelectorAll(".operador-item"));

            function normalizar(texto) {
                if (!texto)
                    return "";

                return texto
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .trim();
            }

            function abrirLista() {
                lista.classList.remove("d-none");
            }

            function fecharLista() {
                lista.classList.add("d-none");
            }

            function filtrarOperadores() {
                const termo = normalizar(pesquisa.value);
                let quantidadeEncontrada = 0;

                operadores.forEach(function (item) {
                    const nome = normalizar(item.dataset.nome);
                    const encontrado = nome.includes(termo);

                    item.classList.toggle("d-none", !encontrado);

                    if (encontrado)
                        quantidadeEncontrada++;
                });

                nenhumOperador.classList.toggle("d-none", quantidadeEncontrada > 0);
                abrirLista();
            }

            function selecionarOperador(item) {
                operadorID.value = item.dataset.id;
                pesquisa.value = item.dataset.nome;
                limpar.classList.remove("d-none");
                fecharLista();

                operadorID.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function limparSelecao() {
                operadorID.value = "";
                pesquisa.value = "";
                limpar.classList.add("d-none");
                nenhumOperador.classList.add("d-none");

                operadores.forEach(function (item) {
                    item.classList.remove("d-none");
                });

                pesquisa.focus();
                abrirLista();
            }

            pesquisa.addEventListener("input", function () {
                if (operadorID.value !== "") {
                    operadorID.value = "";
                    limpar.classList.add("d-none");
                }

                filtrarOperadores();
            });

            pesquisa.addEventListener("focus", function () {
                filtrarOperadores();
            });

            operadores.forEach(function (item) {
                item.addEventListener("click", function () {
                    selecionarOperador(this);
                });
            });

            limpar.addEventListener("click", function () {
                limparSelecao();
            });

            pesquisa.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    fecharLista();
                    pesquisa.blur();
                }

                if (event.key === "Enter") {
                    const visiveis = operadores.filter(function (item) {
                        return !item.classList.contains("d-none");
                    });

                    if (visiveis.length === 1) {
                        event.preventDefault();
                        selecionarOperador(visiveis[0]);
                    }
                }
            });

            document.addEventListener("click", function (event) {
                const clicouPesquisa = pesquisa.contains(event.target);
                const clicouLista = lista.contains(event.target);
                const clicouLimpar = limpar.contains(event.target);

                if (!clicouPesquisa && !clicouLista && !clicouLimpar)
                    fecharLista();
            });

            // Recupera o nome do operador no Edit ou após POST inválido.
            if (operadorID.value !== "" && operadorID.value !== "0") {
                const operadorSelecionado = operadores.find(function (item) {
                    return item.dataset.id === operadorID.value;
                });

                if (operadorSelecionado) {
                    pesquisa.value = operadorSelecionado.dataset.nome;
                    limpar.classList.remove("d-none");
                }
            }
        });
    </script>
}
