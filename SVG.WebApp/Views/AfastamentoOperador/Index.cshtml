@model SVG.App.ViewModels.AfastamentoOperadorListarViewModel

@using SVG.Domain.TiposEstruturados.TiposOperador
@using SVG.Utilities.ExtensionsMethods

@{
    ViewData["Title"] = "Afastamentos";

    var anoVisual = Model.Ano ?? DateTime.Now.Year;
}

<div class="container-fluid mt-4">

    <!-- ========================================================= -->
    <!-- CABEÇALHO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                Afastamentos dos Operadores
            </h3>

            <small class="text-muted">
                Cadastro e consulta dos períodos de afastamento.
            </small>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Novo afastamento
        </a>
    </div>


    <!-- ========================================================= -->
    <!-- MENSAGENS -->
    <!-- ========================================================= -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Sucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Erro"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- ========================================================= -->
    <!-- FILTROS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-light">
            <strong>
                <i class="bi bi-funnel me-1"></i>
                Filtros
            </strong>
        </div>

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  id="formFiltros">

                <div class="row g-3">

                    <!-- OPERADOR -->

                    <div class="col-md-4">

                        <label class="form-label">
                            Operador
                        </label>

                        <select name="pOperadorID"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (var operador in Model.Operadores)
                            {
                                if (Model.OperadorID?.ToString() == operador.Value)
                                {
                                    <option value="@operador.Value"
                                            selected>
                                        @operador.Text
                                    </option>
                                }
                                else
                                {
                                    <option value="@operador.Value">
                                        @operador.Text
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- SEÇÃO -->

                    <div class="col-md-2">

                        <label class="form-label">
                            Seção
                        </label>

                        <select name="pSessaoID"
                                class="form-select">

                            <option value="">
                                Todas
                            </option>

                            @foreach (var sessao in Model.Sessoes)
                            {
                                if (Model.SessaoID?.ToString() == sessao.Value)
                                {
                                    <option value="@sessao.Value"
                                            selected>
                                        @sessao.Text
                                    </option>
                                }
                                else
                                {
                                    <option value="@sessao.Value">
                                        @sessao.Text
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- TIPO -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Tipo de afastamento
                        </label>

                        <select name="pTipoAfastamento"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (XTipoAfastamento tipo
                                                        in Enum.GetValues(typeof(XTipoAfastamento)))
                            {
                                if (Model.TipoAfastamento == tipo)
                                {
                                    <option value="@((int)tipo)"
                                            selected>
                                        @tipo.GetDescription()
                                    </option>
                                }
                                else
                                {
                                    <option value="@((int)tipo)">
                                        @tipo.GetDescription()
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- ANO -->

                    <div class="col-md-1">

                        <label class="form-label">
                            Ano
                        </label>

                        <select name="pAno"
                                id="filtroAno"
                                class="form-select">

                            @foreach (var ano in Model.Anos)
                            {
                                var selecionado =
                                ano.Value ==
                                anoVisual.ToString();

                                if (selecionado)
                                {
                                    <option value="@ano.Value"
                                            selected>
                                        @ano.Text
                                    </option>
                                }
                                else
                                {
                                    <option value="@ano.Value">
                                        @ano.Text
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- MÊS -->

                    <div class="col-md-2">

                        <label class="form-label">
                            Mês
                        </label>

                        <select name="pMes"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @for (var mes = 1; mes <= 12; mes++)
                            {
                                var nomeMes =
                                new DateTime(2000, mes, 1)
                                .ToString(
                                "MMMM",
                                new System.Globalization.CultureInfo("pt-BR"));

                                nomeMes =
                                char.ToUpper(nomeMes[0]) +
                                nomeMes.Substring(1);

                                if (Model.Mes == mes)
                                {
                                    <option value="@mes"
                                            selected>
                                        @nomeMes
                                    </option>
                                }
                                else
                                {
                                    <option value="@mes">
                                        @nomeMes
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <!-- SEGUNDA LINHA -->

                <div class="row g-3 mt-1">

                    <!-- PERÍODO INICIAL -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Período inicial
                        </label>

                        <input type="date"
                               name="pPeriodoInicio"
                               id="periodoInicio"
                               class="form-control"
                               value="@(Model.PeriodoInicio?.ToString("yyyy-MM-dd"))" />

                    </div>


                    <!-- PERÍODO FINAL -->

                    <div class="col-md-3">

                        <label class="form-label">
                            Período final
                        </label>

                        <input type="date"
                               name="pPeriodoFim"
                               id="periodoFim"
                               class="form-control"
                               value="@(Model.PeriodoFim?.ToString("yyyy-MM-dd"))" />

                    </div>


                    <!-- BOTÕES -->

                    <div class="col-md-6 d-flex align-items-end justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Limpar

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>
                            Filtrar

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- RESULTADO -->
    <!-- ========================================================= -->

    <div class="card shadow-sm">

        <div class="card-header bg-light d-flex justify-content-between align-items-center">

            <strong>
                Afastamentos
            </strong>

            <span class="badge bg-secondary">
                @(Model.Afastamentos?.Count() ?? 0)
            </span>

        </div>

        <div class="card-body p-0">

            @if (Model.Afastamentos == null ||
                        !Model.Afastamentos.Any())
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>

                    Nenhum afastamento encontrado.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Operador</th>
                                <th>Seção</th>
                                <th>Tipo de afastamento</th>
                                <th class="text-center">
                                    Data inicial
                                </th>
                                <th class="text-center">
                                    Data final
                                </th>
                                <th class="text-center">
                                    Dias
                                </th>
                                <th class="text-center">
                                    Ações
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Afastamentos)
                            {
                                var quantidadeDias =
                                (item.DataFim.Date -
                                item.DataInicio.Date).Days + 1;

                                <tr>

                                    <td>
                                        <strong>
                                            @item.OperadorNome
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.SessaoNome)
                                                                        ? "-"
                                                                        : item.SessaoNome)
                            </td>

                                    <td>
                                        @item.TipoAfastamento.GetDescription()
                                    </td>

                                    <td class="text-center">
                                        @item.DataInicio.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        @item.DataFim.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        @quantidadeDias
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group btn-group-sm">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.ID"
                                               class="btn btn-outline-primary"
                                               title="Editar">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.ID"
                                               class="btn btn-outline-danger"
                                               title="Excluir">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>