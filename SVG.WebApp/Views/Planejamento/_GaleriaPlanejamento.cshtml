@model IEnumerable<SVG.Domain.Entities.AnexoPlanejamento>
@using SVG.Domain.TiposEstruturados.Enums
@using SVG.Utilities.ExtensionsMethods
@{ var grupos=Enum.GetValues<XSubgrupoImagemPlanejamento>(); }
<section class="card card-body mb-3">
    <h2 class="h4">Imagens do planejamento</h2>
    @foreach(var grupo in grupos)
    {
        <section class="mb-4" data-subgrupo="@((int)grupo)">
            <h3 class="h5">@grupo.GetDescription()</h3>
            @await Html.PartialAsync("_ListaMidiasPlanejamento",Model.Where(a=>a.Subgrupo==grupo))
        </section>
    }
    @if(Model.Any(a=>!a.Subgrupo.HasValue || !grupos.Contains(a.Subgrupo.Value)))
    {
        <section><h3 class="h5">Anexos anteriores (sem subgrupo)</h3>
            @await Html.PartialAsync("_ListaMidiasPlanejamento",Model.Where(a=>!a.Subgrupo.HasValue || !grupos.Contains(a.Subgrupo.Value)))
        </section>
    }
</section>
