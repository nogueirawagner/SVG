@model SVG.App.ViewModels.PlanejamentoViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
<section class="card card-body mb-3"><h2 class="h4">5. Quadro de Funções</h2><div id="integrantes" data-colecao="Integrantes">@for(int i=0;i<Model.Integrantes.Count;i++){
@await Html.PartialAsync("_IntegranteEntrada",Model.Integrantes[i],new ViewDataDictionary(ViewData){["Indice"]=i.ToString()})
}</div><button type="button" data-adicionar="integrantes" data-template="modelo-integrante" class="btn btn-outline-primary align-self-start">Adicionar integrante</button></section>
