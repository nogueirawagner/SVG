@model IEnumerable<SVG.Domain.Entities.AnexoPlanejamento>
@{ var arquivos=Model.OrderBy(a=>a.Ordem).ThenBy(a=>a.ID).ToList(); }
@if(arquivos.Count==0)
{
    <p class="text-muted">Nenhuma imagem ou vídeo cadastrado.</p>
}
else
{
    <div class="row g-3">
    @foreach(var arquivo in arquivos)
    {
        <figure class="col-12 col-md-6 mb-0" data-anexo="@arquivo.ID">
            @if(arquivo.TipoMime is "image/png" or "image/jpeg")
            {
                <a asp-action="Midia" asp-controller="Planejamento" asp-route-id="@arquivo.ID" target="_blank" rel="noopener noreferrer">
                    <img src="@Url.Action("Midia","Planejamento",new{id=arquivo.ID})" alt="@arquivo.NomeArquivo" class="img-fluid rounded border w-100" style="max-height:360px;object-fit:contain" loading="lazy"/>
                </a>
            }
            else if(arquivo.TipoMime is "video/mp4" or "video/webm")
            {
                <video class="rounded border w-100" style="max-height:360px" controls preload="metadata" aria-label="@arquivo.NomeArquivo">
                    <source src="@Url.Action("Midia","Planejamento",new{id=arquivo.ID})" type="@arquivo.TipoMime"/>
                    Seu navegador não suporta este vídeo. Utilize o link para baixar.
                </video>
            }
            <figcaption class="mt-1 text-break">@arquivo.NomeArquivo · <a asp-action="Anexo" asp-controller="Planejamento" asp-route-id="@arquivo.ID">Baixar</a></figcaption>
        </figure>
    }
    </div>
}
