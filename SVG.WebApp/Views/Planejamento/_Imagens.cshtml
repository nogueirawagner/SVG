@model SVG.App.ViewModels.PlanejamentoViewModel
@using SVG.Domain.TiposEstruturados.Enums
@using SVG.Utilities.ExtensionsMethods
@{
    var existentes=ViewBag.AnexosPlanejamento as IEnumerable<AnexoPlanejamento> ?? Array.Empty<AnexoPlanejamento>();
    var grupos=Enum.GetValues<XSubgrupoImagemPlanejamento>();
}
<section class="card card-body mb-3">
    <h2 class="h4">4. Imagens</h2>
    <p class="text-muted">Adicione os arquivos ao subgrupo correspondente. A visualização segue a ordem abaixo; novos arquivos são acrescentados ao final de cada grupo.</p>
    @foreach(var grupo in grupos)
    {
        var inputId=$"anexos-planejamento-{(int)grupo}";
        <fieldset class="border rounded p-3 mb-3">
            <legend class="h5">@grupo.GetDescription()</legend>
            <label for="@inputId" class="form-label">Adicionar imagens ou vídeos</label>
            <input type="file" id="@inputId" name="AnexosPlanejamento_@((int)grupo)" class="form-control mb-3" accept="image/png,image/jpeg,video/mp4,video/webm" multiple/>
            @await Html.PartialAsync("_ListaMidiasPlanejamento",existentes.Where(a=>a.Subgrupo==grupo))
        </fieldset>
    }
    @if(existentes.Any(a=>!a.Subgrupo.HasValue || !grupos.Contains(a.Subgrupo.Value)))
    {
        <section class="border rounded p-3 mb-3"><h3 class="h5">Anexos anteriores (sem subgrupo)</h3>
            <p class="text-muted">Arquivos preservados do cadastro anterior.</p>
            @await Html.PartialAsync("_ListaMidiasPlanejamento",existentes.Where(a=>!a.Subgrupo.HasValue || !grupos.Contains(a.Subgrupo.Value)))
        </section>
    }
    <small>PNG, JPEG, MP4 ou WebM. Até 50 MB por arquivo, 20 arquivos do planejamento e 100 MB por gravação, incluindo anexos dos alvos. Os arquivos já salvos são preservados.</small>
</section>
