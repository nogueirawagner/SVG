@model SVG.App.ViewModels.PlanejamentoViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
<section class="card card-body mb-3"><h2 class="h4">6. Quadro de Horários</h2><div class="row g-3">
<div class="col-md-4"><label asp-for="HorarioBriefingDOE" class="form-label">Briefing na DOE</label><input asp-for="HorarioBriefingDOE" type="time" class="form-control" asp-format="{0:hh\:mm}"/></div>
<div class="col-md-4"><label asp-for="HorarioSaidaDOE" class="form-label">Saída da DOE</label><input asp-for="HorarioSaidaDOE" type="time" class="form-control" asp-format="{0:hh\:mm}"/></div>
<div class="col-md-4"><label asp-for="HorarioBriefingDP" class="form-label">Briefing na DP</label><input asp-for="HorarioBriefingDP" type="time" class="form-control" asp-format="{0:hh\:mm}"/></div>
</div></section>
