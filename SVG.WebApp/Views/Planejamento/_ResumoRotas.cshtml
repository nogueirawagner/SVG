@model SVG.App.ViewModels.PlanejamentoViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
<section class="card card-body mb-3"><h2 class="h4">10. Resumo das Rotas</h2><div class="row g-3">
<div class="col-12"><h3 class="h5">DOE até a unidade de apoio</h3></div><div class="col-md-6"><label asp-for="Link_Rota_DOE_Unidade_Apoio" class="form-label">Link da rota</label><input asp-for="Link_Rota_DOE_Unidade_Apoio" type="url" class="form-control" maxlength="2048" /></div>
<div class="col-md-3"><label asp-for="DistanciaRotaDOEUnidadeApoioKm" class="form-label">Distância (km)</label><input asp-for="DistanciaRotaDOEUnidadeApoioKm" type="number" class="form-control" min="0" max="100000" step="0.01"/></div>
<div class="col-md-3"><label asp-for="DuracaoRotaDOEUnidadeApoioMinutos" class="form-label">Duração (min)</label><input asp-for="DuracaoRotaDOEUnidadeApoioMinutos" type="number" class="form-control" min="0" max="100000" step="1"/></div>
<div class="col-12"><h3 class="h5">DP até o desembarque</h3></div><div class="col-md-6"><label asp-for="Link_Rota_DP_Desemb" class="form-label">Link da rota</label><input asp-for="Link_Rota_DP_Desemb" type="url" class="form-control" maxlength="2048" /></div>
<div class="col-md-3"><label asp-for="DistanciaRotaDPDesembKm" class="form-label">Distância (km)</label><input asp-for="DistanciaRotaDPDesembKm" type="number" class="form-control" min="0" max="100000" step="0.01"/></div>
<div class="col-md-3"><label asp-for="DuracaoRotaDPDesembMinutos" class="form-label">Duração (min)</label><input asp-for="DuracaoRotaDPDesembMinutos" type="number" class="form-control" min="0" max="100000" step="1"/></div>
</div></section>
