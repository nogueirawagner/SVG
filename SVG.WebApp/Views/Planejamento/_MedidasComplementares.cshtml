@model SVG.App.ViewModels.PlanejamentoViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
<section class="card card-body mb-3"><h2 class="h4">9. Medidas Complementares</h2><div class="row g-3">
<div class="col-12"><p>Verificação do material no dia anterior — todos.</p></div><div class="col-md-6"><label asp-for="ResponsavelRelatorio" class="form-label">Responsável pelo relatório e escritura do MBA</label><input asp-for="ResponsavelRelatorio" type="text" class="form-control" maxlength="200" /></div>
<div class="col-md-6"><label asp-for="ResponsavelFotoMBA" class="form-label">Responsável por conferir o endereço no mandado e enviar a foto</label><input asp-for="ResponsavelFotoMBA" type="text" class="form-control" maxlength="200" /></div>
<div class="col-md-12"><label asp-for="Particularidades" class="form-label">Outras medidas e particularidades</label><textarea asp-for="Particularidades" class="form-control" rows="3" maxlength="8000"></textarea></div>
</div><div class="mt-3"><h3 class="h5">Registros adicionais</h3><p class="text-muted">Cada linha é um registro independente. Localizações incluem hospitais e outros pontos de apoio.</p><div id="itens" data-colecao="Itens">@for(int i=0;i<Model.Itens.Count;i++){
@await Html.PartialAsync("_ItemEntrada",Model.Itens[i],new ViewDataDictionary(ViewData){["Indice"]=i.ToString()})
}</div><button type="button" data-adicionar="itens" data-template="modelo-item" class="btn btn-outline-primary align-self-start">Adicionar informação</button></div>
</section>
