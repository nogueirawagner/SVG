@model IReadOnlyList<SVG.Domain.TiposEstruturados.Planejamento.XPlanejamentoMapa>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracao
@{ ViewData["Title"]="Mapa de planejamentos"; }
<div class="container py-4" id="planejamento-mapa-pagina" data-api-key="@Configuracao["GoogleMaps:ApiKey"]" data-map-id="@Configuracao["GoogleMaps:MapId"]" data-detalhes-url="@Url.Action("Detalhes","Planejamento")">
    <a asp-action="Index">Voltar aos planejamentos</a>
    <h1 class="mt-3">Mapa de planejamentos</h1>
    <p class="text-muted">Até 100 planejamentos mais recentes com coordenadas válidas. Ano e mês correspondem à data do apoio. Os filtros se aplicam somente aos registros carregados.</p>
    <div class="card card-body mb-3"><div class="row g-3">
        <div class="col-sm-6 col-lg-3"><label for="mapa-ano" class="form-label">Ano</label><select id="mapa-ano" class="form-select"><option value="">Todos</option></select></div>
        <div class="col-sm-6 col-lg-3"><label for="mapa-mes" class="form-label">Mês</label><select id="mapa-mes" class="form-select"><option value="">Todos</option></select></div>
        <div class="col-sm-6 col-lg-3"><label for="mapa-secao" class="form-label">Seção</label><select id="mapa-secao" class="form-select"><option value="">Todas</option></select></div>
        <div class="col-sm-6 col-lg-3"><label for="mapa-raio" class="form-label">Raio</label><select id="mapa-raio" class="form-select"><option value="0">Sem seleção</option><option value="100">100 m</option><option value="400">400 m</option><option value="500">500 m</option></select></div>
    </div><div class="mt-3 d-flex gap-2 flex-wrap"><button type="button" id="mapa-calor" class="btn btn-outline-danger" aria-pressed="false" disabled>Mapa de Calor</button><button type="button" id="mapa-limpar" class="btn btn-outline-secondary">Limpar filtros</button><button type="button" id="mapa-limpar-centro" class="btn btn-outline-secondary">Limpar ponto central</button></div></div>
    <p id="mapa-instrucao" class="small">Selecione um raio e clique no mapa para definir o centro da busca.</p>
    <p id="mapa-contagem" role="status" aria-live="polite"></p>
    <div id="mapa-calor-legenda" class="alert alert-light border" hidden>
        <strong>Mapa de Calor:</strong> o número indica os planejamentos na área, conforme os filtros atuais.
        <span class="d-inline-block rounded mx-2 align-middle" style="width:90px;height:14px;background:linear-gradient(to right,#ffe55c,#ff9800,#e02020)" aria-hidden="true"></span>Menor → maior concentração.
        <span id="mapa-calor-escala" class="d-block small mt-1" role="status" aria-live="polite"></span>
    </div>
    <div id="mapa-erro" class="alert alert-warning" role="alert" hidden></div>
    <div id="planejamento-mapa" class="border rounded" style="height:65vh;min-height:360px" aria-label="Mapa de planejamentos"></div>
    <h2 class="h5 mt-3">Planejamentos exibidos</h2>
    <ul id="mapa-resultados" class="list-group"></ul>
</div>
<script type="application/json" id="planejamento-mapa-dados">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))</script>
@section Scripts {
<script src="~/js/mapas/mapa-calor.js" asp-append-version="true"></script>
<script src="~/js/mapas/google-maps.js" asp-append-version="true"></script>
<script src="~/js/planejamento-mapa.js" asp-append-version="true"></script>
}
