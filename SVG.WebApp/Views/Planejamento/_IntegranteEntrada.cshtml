@model SVG.Domain.TiposEstruturados.Planejamento.XIntegranteEntrada
@using Microsoft.AspNetCore.Mvc.Rendering
@{var prefixo=$"Integrantes[{ViewData["Indice"]}]"; var funcoes=new[]{"APH-1","APH-2","Motorista","Navegador","Comunicação","GLO"};}
<div class="border rounded p-3 mb-2 registro">
<div class="fw-semibold small mb-2" data-secao-integrante>Seção - Não informada</div>
<div class="row g-2">
<div class="col-md-3"><label class="form-label w-100">Operador<select class="form-select" name="@(prefixo).OperadorID" data-campo="OperadorID" required><option value="">Selecione</option>@foreach(var o in (IEnumerable<SelectListItem>)ViewBag.Operadores){<option value="@o.Value" selected="@(o.Value==Model.OperadorID.ToString())">@o.Text</option>}</select></label></div>
<div class="col-md-3"><label class="form-label w-100">Entrada<input class="form-control" name="@(prefixo).Entrada" value="@Model.Entrada" data-campo="Entrada" maxlength="100"/></label></div>
<div class="col-md-3"><label class="form-label w-100">Função<select class="form-select" name="@(prefixo).Funcao" data-campo="Funcao" required>
<option value="">Selecione</option>
@foreach(var funcao in funcoes){<option value="@funcao" selected="@(funcao==Model.Funcao)">@funcao</option>}
@if(!string.IsNullOrWhiteSpace(Model.Funcao) && !funcoes.Contains(Model.Funcao)){<option value="@Model.Funcao" selected>@Model.Funcao (valor anterior)</option>}
</select></label></div>
<div class="col-md-3"><label class="form-label w-100">Prefixo / viatura<select class="form-select" name="@(prefixo).ViaturaID" data-campo="ViaturaID"><option value="">Não definida</option>@foreach(var v in (IEnumerable<SelectListItem>)ViewBag.Viaturas){<option value="@v.Value" data-secao="@(((IDictionary<string,int>)ViewBag.ViaturasSecoes)[v.Value])" selected="@(v.Value==Model.ViaturaID?.ToString())">@v.Text</option>}</select></label></div>
</div><button type="button" class="btn btn-sm btn-outline-danger" data-remover>Remover</button></div>
