@model SVG.Domain.Entities.Planejamento
@using System.Globalization
@{ ViewData["Title"]=Model.Titulo; var mapa=Model.Latitude.HasValue && Model.Longitude.HasValue ? "https://www.google.com/maps/search/?api=1&query="+Model.Latitude.Value.ToString(CultureInfo.InvariantCulture)+","+Model.Longitude.Value.ToString(CultureInfo.InvariantCulture):null; }
<div class="container py-4">
<a asp-action="Index">Voltar</a>
@if(TempData["Sucesso"] is string sucesso){<div class="alert alert-success mt-3">@sucesso</div>}
<div class="d-flex justify-content-between align-items-center my-3"><h1>@Model.Titulo</h1>@if((bool)ViewBag.PodeEditar){<a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.ID">Editar rascunho</a>}</div>
<p><span class="badge bg-secondary">@Model.Situacao</span> Seção: @Model.Secao.Nome · Data prevista: @Model.DataPrevista?.ToString("dd/MM/yyyy HH:mm")</p>
<div class="card card-body mb-3"><h2 class="h4">Informações preliminares</h2><p>OS: @Model.OrdemServico · Unidade de apoio: @Model.UnidadeApoio</p><p>MBA: @(Model.MBA?"Sim":"Não") · MP: @(Model.MP?"Sim":"Não") · Nº MBA: @Model.NumeroMBA</p><p class="preservar-linhas">@Model.Objetivo</p></div>
<div class="card card-body mb-3"><h2 class="h4">Endereço do planejamento</h2><p>@Model.Endereco</p><p>@Model.Referencia</p><p>Latitude: @Model.Latitude · Longitude: @Model.Longitude</p>@if(mapa!=null){<a href="@mapa" target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a>}else{<p class="text-muted">Coordenadas não informadas.</p>}</div>
<h2 class="h4">Alvos</h2><div class="row g-3 mb-4">@foreach(var v in Model.Alvos){<div class="col-md-6"><div class="card h-100"><div class="card-body"><img src="@Url.Action("Foto",new{id=v.AlvoID})" class="alvo-foto float-start me-3" style="max-width:110px;max-height:130px" alt="Foto de @v.Alvo.Nome"/><span class="foto-ausente text-muted" hidden>Sem foto</span><h3 class="h5"><a asp-action="Alvo" asp-route-id="@v.AlvoID">@v.Codigo @v.Alvo.Nome</a></h3><p>CPF: @(v.Alvo.CPF??"Não informado")</p><p>@v.Alvo.Alcunha</p><p class="preservar-linhas">@v.Observacoes</p></div></div></div>}</div>
<h2 class="h4">Equipe e viaturas</h2><div class="table-responsive"><table class="table"><thead><tr><th>Operador</th><th>Entrada</th><th>Função</th><th>Viatura</th></tr></thead><tbody>@foreach(var i in Model.Integrantes){<tr><td>@i.Operador.Nome</td><td>@i.Entrada</td><td>@i.Funcao</td><td>@(string.IsNullOrWhiteSpace(i.Viatura?.Prefixo)?i.Viatura?.Placa:i.Viatura.Prefixo)</td></tr>}</tbody></table></div>
@foreach(var grupo in Model.Itens.GroupBy(i=>i.Tipo)){
<h2 class="h4">@(grupo.Key switch {"Horario"=>"Horários","Rota"=>"Rotas","Localizacao"=>"Localizações de apoio","Mandado"=>"Mandados","Providencia"=>"Providências",_=>grupo.Key})</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Descrição</th><th>Data / hora</th><th>Responsável</th><th>Referência</th></tr></thead><tbody>@foreach(var i in grupo){<tr><td>@i.Descricao</td><td>@i.DataHora?.ToString("dd/MM/yyyy HH:mm")</td><td>@i.Responsavel</td><td>@if(i.Url!=null){<a href="@i.Url" target="_blank" rel="noopener noreferrer">Abrir link</a>} @if(i.DistanciaKm.HasValue){<span>@i.DistanciaKm km</span>} @if(i.DuracaoMinutos.HasValue){<span> · @i.DuracaoMinutos min</span>}</td></tr>}</tbody></table></div>}
<div class="card card-body mb-3"><h2 class="h4">Comunicações</h2><p>Viaturas: @Model.CanalViaturas</p><p>Operadores: @Model.CanalOperadores</p></div>
<div class="card card-body mb-3"><h2 class="h4">Apoio médico</h2><p class="preservar-linhas">@Model.ApoioMedico</p></div>
<div class="card card-body mb-3"><h2 class="h4">Particularidades</h2><p class="preservar-linhas">@Model.Particularidades</p></div>
@await Html.PartialAsync("_GaleriaPlanejamento",Model.Anexos)
@await Html.PartialAsync("_DetalhesPadrao",Model)
<small class="text-muted">Cadastro: @Model.DataHoraCriacao.ToString("dd/MM/yyyy HH:mm") · Última alteração: @Model.DataHoraAtualizacao.ToString("dd/MM/yyyy HH:mm")</small>
</div>
@section Scripts{<script src="~/js/planejamento.js" asp-append-version="true"></script>}
