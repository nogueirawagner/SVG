@model SVG.Domain.Entities.Planejamento
@using System.Globalization
@{ ViewData["Title"]=Model.ObterTituloExibicao(); var mapa=Model.Latitude.HasValue && Model.Longitude.HasValue ? "https://www.google.com/maps/search/?api=1&query="+Model.Latitude.Value.ToString(CultureInfo.InvariantCulture)+","+Model.Longitude.Value.ToString(CultureInfo.InvariantCulture):null; }
<div class="container py-4">
<a asp-action="Index">Voltar</a>
@if(TempData["ErroPdf"] is string erroPdf){<div class="alert alert-danger mt-3" role="alert">@erroPdf</div>}
@if(TempData["Sucesso"] is string sucesso){<div class="alert alert-success mt-3">@sucesso</div>}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center my-3"><h1>@ViewData["Title"]</h1><a class="btn btn-outline-danger ms-2 flex-shrink-0" asp-action="GerarPdf" asp-route-id="@Model.ID"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Gerar PDF</a>@if((bool)ViewBag.PodeEditar){<a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.ID">Editar rascunho</a>}</div>
<p><strong>Situação:</strong> <span class="badge bg-secondary">@Model.Situacao</span></p>
<p><strong>Seção:</strong> @Model.Secao.Nome</p>
<p><strong>Data prevista:</strong> @Model.DataPrevista?.ToString("dd/MM/yyyy HH:mm")</p>
<div class="card card-body mb-3"><h2 class="h4">Informações preliminares</h2>
<p class="mb-2"><strong>OS:</strong> @Model.OrdemServico</p>
<p class="mb-2"><strong>Unidade de Apoio:</strong> @Model.UnidadeApoio</p>
<p class="mb-2"><strong>MBA:</strong> @(Model.MBA?"Sim":"Não") <strong class="ms-3">MP:</strong> @(Model.MP?"Sim":"Não")</p>
<p class="mb-2"><strong>Nº MBA:</strong> @Model.NumeroMBA</p>
@if(!string.IsNullOrWhiteSpace(Model.Objetivo)){<p class="preservar-linhas mb-0"><strong>Objetivo:</strong> @Model.Objetivo</p>}
</div>
<div class="card card-body mb-3"><h2 class="h4">Endereço do planejamento</h2><p><strong>Endereço:</strong> @Model.Endereco</p><p><strong>Referência:</strong> @Model.Referencia</p><p><strong>Latitude:</strong> @Model.Latitude</p><p><strong>Longitude:</strong> @Model.Longitude</p>@if(mapa!=null){<a href="@mapa" target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a>}else{<p class="text-muted">Coordenadas não informadas.</p>}</div>
<h2 class="h4">Alvos</h2><div class="row g-3 mb-4">
@foreach(var v in Model.Alvos){
<div class="col-md-6"><div class="card h-100"><div class="card-body">
<div class="d-flex flex-wrap gap-3">
<div><img src="@Url.Action("Foto",new{id=v.AlvoID})" class="alvo-foto rounded" style="max-width:110px;max-height:130px" alt="Foto de @v.Alvo.Nome"/><span class="foto-ausente text-muted" hidden>Sem foto</span></div>
<div class="flex-grow-1 text-break">
<h3 class="h6 fw-bold">Nome: <a asp-action="Alvo" asp-route-id="@v.AlvoID">@v.Alvo.Nome</a></h3>
<p class="mb-2"><strong>Alcunha:</strong> @(v.Alvo.Alcunha??"Não informada")</p>
<p class="mb-2"><strong>Mãe:</strong> @(v.Alvo.NomeMae??"Não informada")</p>
<p class="mb-2"><strong>Pai:</strong> @(v.Alvo.NomePai??"Não informado")</p>
<p class="mb-2"><strong>CPF:</strong> @(v.Alvo.CPF??"Não informado")</p>
@if(!string.IsNullOrWhiteSpace(v.Codigo)){<p class="mb-2"><strong>Código:</strong> @v.Codigo</p>}
@if(!string.IsNullOrWhiteSpace(v.Observacoes)){<p class="preservar-linhas mb-0"><strong>Observações:</strong> @v.Observacoes</p>}
</div></div></div></div></div>
}</div>
@await Html.PartialAsync("_GaleriaPlanejamento",Model.Anexos)
<h2 class="h4">Equipe e viaturas</h2><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Operador</th><th>Entrada</th><th>Função</th><th>Viatura</th></tr></thead><tbody>@foreach(var i in Model.Integrantes){<tr><td>@i.Operador.Nome</td><td>@i.Entrada</td><td>@i.Funcao</td><td>@(string.IsNullOrWhiteSpace(i.Viatura?.Prefixo)?i.Viatura?.Placa:i.Viatura.Prefixo)</td></tr>}</tbody></table></div>
@foreach(var grupo in Model.Itens.GroupBy(i=>i.Tipo)){
<h2 class="h4">@(grupo.Key switch {"Horario"=>"Horários","Rota"=>"Rotas","Localizacao"=>"Localizações de apoio","Mandado"=>"Mandados","Providencia"=>"Providências",_=>grupo.Key})</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Descrição</th><th>Data / hora</th><th>Responsável</th><th>Referência</th></tr></thead><tbody>@foreach(var i in grupo){<tr><td>@i.Descricao</td><td>@i.DataHora?.ToString("dd/MM/yyyy HH:mm")</td><td>@i.Responsavel</td><td>@if(i.Url!=null){<a href="@i.Url" target="_blank" rel="noopener noreferrer">Abrir link</a>} @if(i.DistanciaKm.HasValue){<span>@i.DistanciaKm km</span>} @if(i.DuracaoMinutos.HasValue){<span> · @i.DuracaoMinutos min</span>}</td></tr>}</tbody></table></div>}
<div class="card card-body mb-3"><h2 class="h4">Comunicações</h2><p><strong>Viaturas:</strong> @Model.CanalViaturas</p><p><strong>Operadores:</strong> @Model.CanalOperadores</p></div>
<div class="card card-body mb-3"><h2 class="h4">Apoio médico</h2><p class="preservar-linhas"><strong>Informações:</strong> @Model.ApoioMedico</p></div>
<div class="card card-body mb-3"><h2 class="h4">Particularidades</h2><p class="preservar-linhas"><strong>Observações:</strong> @Model.Particularidades</p></div>
@await Html.PartialAsync("_DetalhesPadrao",Model)
<div class="small text-muted"><p><strong>Cadastro:</strong> @Model.DataHoraCriacao.ToString("dd/MM/yyyy HH:mm")</p><p><strong>Última alteração:</strong> @Model.DataHoraAtualizacao.ToString("dd/MM/yyyy HH:mm")</p></div>
</div>
<div class="container pb-4"><a class="btn btn-outline-danger" asp-action="GerarPdf" asp-route-id="@Model.ID"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Gerar PDF</a></div>
@section Scripts{<script src="~/js/planejamento.js" asp-append-version="true"></script>}
