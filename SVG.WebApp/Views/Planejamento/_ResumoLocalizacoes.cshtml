@model SVG.App.ViewModels.PlanejamentoViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
<section class="card card-body mb-3"><h2 class="h4">11. Resumo das Localizações</h2><div class="row g-3">
<div class="col-md-6"><label asp-for="Link_Localizacao_Desemb" class="form-label">Desembarque — link da localização</label><input asp-for="Link_Localizacao_Desemb" type="url" class="form-control" maxlength="2048" /></div>
<div class="col-md-6"><label for="link-alvo-resumo" class="form-label">Alvo — link da localização</label><input id="link-alvo-resumo" type="url" value="@Model.Link_Endereco_Alvo" class="form-control" readonly/><small class="form-text">Mesmo link informado em Endereço do Alvo.</small></div><div class="col-md-6"><label asp-for="Link_Localizacao_Hospital_1" class="form-label">Hospital 1 — link da localização</label><input asp-for="Link_Localizacao_Hospital_1" type="url" class="form-control" maxlength="2048" /></div>
<div class="col-md-6"><label asp-for="Link_Localizacao_Hospital_2" class="form-label">Hospital 2 — link da localização</label><input asp-for="Link_Localizacao_Hospital_2" type="url" class="form-control" maxlength="2048" /></div>
<div class="col-md-6"><label asp-for="CoordenadaZPH" class="form-label">ZPH — coordenada</label><input asp-for="CoordenadaZPH" type="text" class="form-control" maxlength="200" /></div>
</div></section>
