@model SVG.App.ViewModels.PlanejamentoViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using SVG.Domain.TiposEstruturados.Planejamento
@{ ViewData["Title"]=Model.ID==0?"Novo planejamento":"Editar planejamento"; }
<div class="container py-4">
<a asp-action="Index">Voltar</a><h1 class="mt-3">@ViewData["Title"]</h1>
<p class="text-muted">Informe o endereço e adicione os alvos associados. Os dados só serão gravados ao salvar.</p>
<form asp-action="Salvar" method="post" enctype="multipart/form-data" id="planejamento-form">
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<input asp-for="ID" type="hidden"/><input asp-for="Versao" type="hidden"/>
<div id="planejamento-grupos">
@await Html.PartialAsync("_InformacoesPreliminares",Model)
@await Html.PartialAsync("_IdentificacaoAlvo",Model)
@await Html.PartialAsync("_EnderecoAlvo",Model)
@await Html.PartialAsync("_Imagens",Model)
@await Html.PartialAsync("_QuadroFuncoes",Model)
@await Html.PartialAsync("_QuadroHorarios",Model)
@await Html.PartialAsync("_Comunicacoes",Model)
@await Html.PartialAsync("_AphMedico",Model)
@await Html.PartialAsync("_MedidasComplementares",Model)
@await Html.PartialAsync("_ResumoRotas",Model)
@await Html.PartialAsync("_ResumoLocalizacoes",Model)
</div>
<script type="application/json" id="planejamento-campos-invalidos">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData.ModelState.Where(x=>x.Value!.Errors.Count>0).Select(x=>x.Key)))</script>
<div class="alert alert-info">Ao finalizar, este planejamento ficará disponível somente para leitura. Confira os dados antes de finalizar.</div>
<button type="submit" class="btn btn-primary">Salvar rascunho</button> <button type="submit" name="finalizar" value="true" class="btn btn-success">Salvar e finalizar</button>
</form>
<template id="modelo-alvo">@await Html.PartialAsync("_AlvoEntrada",new XAlvoEntrada(),new ViewDataDictionary(ViewData){["Indice"]="__i__"})</template>
<template id="modelo-integrante">@await Html.PartialAsync("_IntegranteEntrada",new XIntegranteEntrada(),new ViewDataDictionary(ViewData){["Indice"]="__i__"})</template>
<template id="modelo-item">@await Html.PartialAsync("_ItemEntrada",new XItemEntrada(),new ViewDataDictionary(ViewData){["Indice"]="__i__"})</template>
</div>
@await Html.PartialAsync("_VisualizadorMidia")
@section Scripts{<script src="~/js/planejamento.js" asp-append-version="true"></script>}
