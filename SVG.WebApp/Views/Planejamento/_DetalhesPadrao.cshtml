@model SVG.Domain.Entities.Planejamento
<div class="card card-body mb-3"><h2 class="h4">Quadro de Horários</h2>
<p><strong>Briefing na DOE:</strong> @Model.HorarioBriefingDOE?.ToString(@"hh\:mm")</p>
<p><strong>Saída da DOE:</strong> @Model.HorarioSaidaDOE?.ToString(@"hh\:mm")</p>
<p><strong>Briefing na DP:</strong> @Model.HorarioBriefingDP?.ToString(@"hh\:mm")</p>
<p><strong>Local do briefing:</strong> @Model.LocalBriefing</p></div>
<div class="card card-body mb-3"><h2 class="h4">APH – Médico</h2><p><strong>Socorrista APH-1:</strong> @Model.SocorristaAPH1</p><p><strong>Socorrista APH-2:</strong> @Model.SocorristaAPH2</p><p><strong>Viatura:</strong> @Model.PrefixoVtrAPH</p><p><strong>Motorista:</strong> @Model.MotoristaVtrAPH</p></div>
<div class="card card-body mb-3"><h2 class="h4">Medidas Complementares</h2><p><strong>Relatório e escritura do MBA:</strong> @Model.ResponsavelRelatorio</p><p><strong>Conferência do endereço e foto do MBA:</strong> @Model.ResponsavelFotoMBA</p></div>
<div class="card card-body mb-3"><h2 class="h4">Resumo das Rotas</h2>
@foreach(var rota in new[]{(Nome:$"DOE até {Model.UnidadeApoio}",Link:Model.Link_Rota_DOE_Unidade_Apoio,Km:Model.DistanciaRotaDOEUnidadeApoioKm,Minutos:Model.DuracaoRotaDOEUnidadeApoioMinutos),(Nome:"DP até desembarque",Link:Model.Link_Rota_DP_Desemb,Km:Model.DistanciaRotaDPDesembKm,Minutos:Model.DuracaoRotaDPDesembMinutos)}){
<div class="mb-3">
<p><strong>Rota:</strong> @rota.Nome</p>
<p><strong>Distância:</strong> @rota.Km km</p>
<p><strong>Duração:</strong> @rota.Minutos min</p>
<p><strong>Link:</strong> @if(rota.Link!=null){<a href="@rota.Link" target="_blank" rel="noopener noreferrer">Abrir rota</a>}else{<span>Não informado</span>}</p>
</div>
}</div>
<div class="card card-body mb-3"><h2 class="h4">Resumo das Localizações</h2>
@foreach(var local in new[]{(Nome:"Desembarque",Link:Model.Link_Localizacao_Desemb),(Nome:"Alvo",Link:Model.Link_Endereco_Alvo),(Nome:"Hospital 1",Link:Model.Link_Localizacao_Hospital_1),(Nome:"Hospital 2",Link:Model.Link_Localizacao_Hospital_2)}){
<p><strong>@local.Nome:</strong> @if(local.Link!=null){<a href="@local.Link" target="_blank" rel="noopener noreferrer">Abrir localização</a>}else{<span>Não informada</span>}</p>
}
<p><strong>ZPH (coordenada):</strong> @Model.CoordenadaZPH</p></div>
