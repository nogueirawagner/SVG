@model SVG.WebApp.Models.ViaturaDevolucaoViewModel

@{
    Layout = "_LayoutOperador";
    ViewData["Title"] = "Devolver Viatura";

    var operadoresJson = (string)(ViewBag.OperadoresJson ?? "[]");

    const int limiteAlertaRevisao = 2800;

    int? kmRestanteRevisao = Model.KmProximaRevisao.HasValue
        ? Model.KmProximaRevisao.Value - Model.KmAtual
        : (int?)null;
}

<div class="container mt-4" style="max-width: 650px;">

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Devolução de Viatura
            </h5>
        </div>

        <div class="card-body">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-4">

                <h4>
                    @Model.Prefixo
                </h4>

                <div class="text-muted">
                    @Model.Modelo
                    |
                    @Model.Placa
                </div>

                <div class="text-muted">
                    KM atual:
                    @Model.KmAtual.ToString("N0")
                </div>

            </div>

            @if (kmRestanteRevisao.HasValue && kmRestanteRevisao.Value <= 0)
            {
                <div id="alertaRevisao"
                     class="alert alert-danger shadow-sm">
                    <strong>⚠ Revisão vencida</strong><br />
                    Esta viatura já ultrapassou a quilometragem cadastrada para revisão.
                </div>
            }
            else if (kmRestanteRevisao.HasValue &&
            kmRestanteRevisao.Value <= limiteAlertaRevisao)
            {
                <div id="alertaRevisao"
                     class="alert alert-warning shadow-sm">
                    <strong>⚠ Atenção à revisão</strong><br />
                    Faltam
                    <strong>@kmRestanteRevisao.Value.ToString("N0") km</strong>
                    para a próxima revisão.
                </div>
            }
            else
            {
                <div id="alertaRevisao"
                     class="alert alert-warning shadow-sm"
                     style="display:none;">
                </div>
            }

            <form asp-action="Devolver"
                  method="post"
                  id="formDevolucao">

                @Html.AntiForgeryToken()

                <input asp-for="ViaturaID"
                       type="hidden" />

                <input asp-for="Prefixo"
                       type="hidden" />

                <input asp-for="Placa"
                       type="hidden" />

                <input asp-for="Modelo"
                       type="hidden" />

                <input asp-for="KmAtual"
                       type="hidden" />

                <input asp-for="KmProximaRevisao"
                       type="hidden"
                       id="KmProximaRevisao" />

                <input asp-for="OperadorID"
                       type="hidden"
                       id="OperadorID" />

                <input asp-for="OperadorNome"
                       type="hidden"
                       id="OperadorNome" />

                <!-- OPERADOR -->
                <div class="mb-3">

                    <label class="form-label">
                        Operador responsável pela devolução
                    </label>

                    <input type="text"
                           id="pesquisaOperador"
                           class="form-control"
                           value="@Model.OperadorNome"
                           placeholder="Digite o nome, alcunha ou numérica..."
                           autocomplete="off" />

                    <div id="resultadoOperadores"
                         class="list-group mt-1"
                         style="display:none; max-height:250px; overflow-y:auto;">
                    </div>

                    <span asp-validation-for="OperadorID"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        O operador logado é selecionado automaticamente.
                        Para alterar, pesquise outro operador.
                    </div>

                </div>

                <!-- KM FINAL -->
                <div class="mb-3">

                    <label asp-for="KmFinal"
                           class="form-label">
                        KM da devolução
                    </label>

                    <input asp-for="KmFinal"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="Informe o KM atual da viatura" />

                    <span asp-validation-for="KmFinal"
                          class="text-danger">
                    </span>

                </div>

                <!-- ABASTECIMENTO -->
                <div class="mb-3">

                    <div class="form-check form-switch">

                        <input asp-for="Abastecimento"
                               class="form-check-input"
                               type="checkbox"
                               id="abastecimento" />

                        <label class="form-check-label"
                               for="abastecimento">
                            Viatura foi abastecida?
                        </label>

                    </div>

                </div>

                <!-- KM ABASTECIMENTO -->
                <div class="mb-4"
                     id="divKmAbastecimento"
                     style="display:none;">

                    <label asp-for="KmAbastecimento"
                           class="form-label">
                        KM do abastecimento
                    </label>

                    <input asp-for="KmAbastecimento"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="Informe o KM em que a viatura foi abastecida" />

                    <span asp-validation-for="KmAbastecimento"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Informe a quilometragem indicada no momento do abastecimento.
                    </div>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Listar"
                       class="btn btn-secondary">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        Confirmar Devolução
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const operadores = @Html.Raw(operadoresJson);

        const pesquisa = document.getElementById('pesquisaOperador');
        const resultado = document.getElementById('resultadoOperadores');
        const operadorID = document.getElementById('OperadorID');
        const operadorNome = document.getElementById('OperadorNome');
        const form = document.getElementById('formDevolucao');

        const abastecimento =
            document.getElementById('abastecimento');

        const divKmAbastecimento =
            document.getElementById('divKmAbastecimento');

        const kmAbastecimento =
            document.getElementById('KmAbastecimento');

        const kmFinal =
            document.getElementById('KmFinal');

        const kmProximaRevisao =
            document.getElementById('KmProximaRevisao');

        const alertaRevisao =
            document.getElementById('alertaRevisao');

        const limiteAlertaRevisao = 2800;


        function normalizarTexto(texto) {

            return (texto || '')
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim();
        }


        function esconderResultados() {

            resultado.innerHTML = '';
            resultado.style.display = 'none';
        }


        function selecionarOperador(operador) {

            operadorID.value = operador.id;
            operadorNome.value = operador.descricao;

            pesquisa.value = operador.descricao;

            esconderResultados();
        }


        pesquisa.addEventListener('input', function () {

            const termo = normalizarTexto(this.value);

            operadorID.value = '';
            operadorNome.value = '';

            resultado.innerHTML = '';

            if (!termo) {

                esconderResultados();

                return;
            }

            const filtrados = operadores
                .filter(function (operador) {

                    const nome =
                        normalizarTexto(operador.nome);

                    const alcunha =
                        normalizarTexto(operador.alcunha);

                    const numerica =
                        normalizarTexto(operador.numerica);

                    const descricao =
                        normalizarTexto(operador.descricao);

                    return nome.includes(termo)
                        || alcunha.includes(termo)
                        || numerica.includes(termo)
                        || descricao.includes(termo);
                })
                .slice(0, 15);


            if (filtrados.length === 0) {

                resultado.innerHTML =
                    '<div class="list-group-item text-muted">' +
                        'Nenhum operador encontrado.' +
                    '</div>';

                resultado.style.display = 'block';

                return;
            }


            filtrados.forEach(function (operador) {

                const item =
                    document.createElement('button');

                item.type = 'button';

                item.className =
                    'list-group-item list-group-item-action';

                item.textContent =
                    operador.descricao;

                item.addEventListener('click', function () {

                    selecionarOperador(operador);

                });

                resultado.appendChild(item);
            });


            resultado.style.display = 'block';
        });


        pesquisa.addEventListener('focus', function () {

            if (this.value.trim() !== '')
                this.select();
        });


        document.addEventListener('click', function (event) {

            if (!pesquisa.contains(event.target) &&
                !resultado.contains(event.target)) {

                esconderResultados();
            }
        });


        function atualizarAbastecimento() {

            if (abastecimento.checked) {

                divKmAbastecimento.style.display = 'block';

                kmAbastecimento.required = true;

            }
            else {

                divKmAbastecimento.style.display = 'none';

                kmAbastecimento.required = false;

                kmAbastecimento.value = '';
            }
        }


        abastecimento.addEventListener(
            'change',
            atualizarAbastecimento);

        atualizarAbastecimento();


               function atualizarAlertaRevisao() {

            if (!kmFinal || !kmProximaRevisao || !alertaRevisao)
                return;

            const kmFinalValor = parseInt(kmFinal.value);
            const kmRevisaoValor = parseInt(kmProximaRevisao.value);

            /*
             * Enquanto o valor estiver vazio ou incompleto,
             * não altera o alerta que já está sendo exibido.
             */
            if (isNaN(kmFinalValor) || isNaN(kmRevisaoValor))
                return;

            const restante = kmRevisaoValor - kmFinalValor;

            /*
             * REVISÃO VENCIDA
             * É o nível mais crítico.
             */
            if (restante <= 0) {

                alertaRevisao.classList.remove('alert-warning');
                alertaRevisao.classList.add('alert-danger');

                alertaRevisao.innerHTML =
                    '<strong>⚠ Revisão vencida</strong><br />' +
                    'Com o KM informado na devolução, esta viatura ultrapassou ' +
                    'a revisão em <strong>' +
                    Math.abs(restante).toLocaleString('pt-BR') +
                    ' km</strong>.';

                alertaRevisao.style.display = 'block';

                return;
            }

            /*
             * REVISÃO PRÓXIMA
             */
            if (restante <= limiteAlertaRevisao) {

                /*
                 * Se já ficou vermelho, não volta para laranja.
                 */
                if (alertaRevisao.classList.contains('alert-danger'))
                    return;

                alertaRevisao.classList.remove('alert-danger');
                alertaRevisao.classList.add('alert-warning');

                alertaRevisao.innerHTML =
                    '<strong>⚠ Atenção à revisão</strong><br />' +
                    'Com o KM informado na devolução, faltarão apenas <strong>' +
                    restante.toLocaleString('pt-BR') +
                    ' km</strong> para a próxima revisão.';

                alertaRevisao.style.display = 'block';

                return;
            }

            /*
             * IMPORTANTE:
             * Se ainda não entrou na faixa de revisão,
             * não fazemos nada.
             *
             * Um alerta que já apareceu não deve desaparecer
             * durante a edição do KM.
             */
        }

        if (kmFinal) {
            kmFinal.addEventListener(
                'input',
                atualizarAlertaRevisao
            );
        }

        form.addEventListener('submit', function (event) {

            if (!operadorID.value ||
                parseInt(operadorID.value) <= 0) {

                event.preventDefault();

                alert('Selecione um operador na pesquisa.');

                pesquisa.focus();

                return;
            }

            if (abastecimento.checked &&
                !kmAbastecimento.value) {

                event.preventDefault();

                alert('Informe o KM do abastecimento.');

                kmAbastecimento.focus();
            }
        });

    </script>

}