@using SVG.Domain.Entities
@using SVG.Domain.TiposEstruturados.Enums

@model IEnumerable<Viatura>

@{
    Layout = "_LayoutOperador";
    ViewData["Title"] = "Controle de Viaturas";

    var sessoes = (IEnumerable<Sessao>)ViewBag.Sessoes;

    const int limiteAlertaRevisao = 2800;

    var qtdRevisaoProxima = Model.Count(x =>
        x.KmProximaRevisao.HasValue &&
        (x.KmProximaRevisao.Value - x.KmAtual) > 0 &&
        (x.KmProximaRevisao.Value - x.KmAtual) <= limiteAlertaRevisao);

    var qtdRevisaoVencida = Model.Count(x =>
        x.KmProximaRevisao.HasValue &&
        (x.KmProximaRevisao.Value - x.KmAtual) <= 0);
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">Controle de Viaturas</h3>
            <small class="text-muted">
                Viaturas disponíveis e em utilização
            </small>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (qtdRevisaoProxima > 0 || qtdRevisaoVencida > 0)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm"
             role="alert">
            <div>
                <strong>⚠ Atenção às revisões</strong>
                <div class="mt-1">
                    @if (qtdRevisaoVencida > 0)
                    {
                        <button type="button"
                                class="badge bg-danger border-0 me-2 btn-filtro-revisao"
                                data-revisao="vencida"
                                title="Mostrar somente revisões vencidas">
                            @qtdRevisaoVencida revisão(ões) vencida(s)
                        </button>
                    }

                    @if (qtdRevisaoProxima > 0)
                    {
                        <button type="button"
                                class="badge bg-warning text-dark border-0 btn-filtro-revisao"
                                data-revisao="proxima"
                                title="Mostrar somente viaturas próximas da revisão">
                            @qtdRevisaoProxima próxima(s) da revisão
                        </button>
                    }
                </div>
            </div>

            <button type="button"
                    id="btnVerAlertasRevisao"
                    class="btn btn-sm btn-outline-dark">
                Ver viaturas com alerta
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Pesquisar</label>
                    <input type="text"
                           id="filtroTexto"
                           class="form-control"
                           placeholder="Prefixo, placa, modelo ou responsável..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Seção</label>
                    <select id="filtroSecao"
                            class="form-select">
                        <option value="">Todas</option>

                        @foreach (var secao in Model
                                                .Where(x => x.Sessao != null)
                                                .Select(x => x.Sessao)
                                                .GroupBy(x => x.ID)
                                                .Select(x => x.First())
                                                .OrderBy(x => x.Nome))
                        {
                            <option value="@secao.ID">
                                @secao.Nome
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Tipo</label>
                    <select id="filtroTipo"
                            class="form-select">
                        <option value="">Todos</option>

                        <option value="@((int)XTipoCaracterizacaoViatura.Caracterizada)">
                            Caracterizada
                        </option>

                        <option value="@((int)XTipoCaracterizacaoViatura.Descaracterizada)">
                            Descaracterizada
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Situação</label>
                    <select id="filtroSituacao"
                            class="form-select">
                        <option value="">Todas</option>

                        <option value="@((int)XSituacaoViatura.Disponivel)">
                            Disponível
                        </option>

                        <option value="@((int)XSituacaoViatura.EmUso)">
                            Em uso
                        </option>

                        <option value="@((int)XSituacaoViatura.Manutencao)">
                            Manutenção
                        </option>

                        <option value="@((int)XSituacaoViatura.Indisponivel)">
                            Indisponível
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Revisão</label>
                    <select id="filtroRevisao"
                            class="form-select">
                        <option value="">Todas</option>
                        <option value="normal">Normal</option>
                        <option value="proxima">Próxima</option>
                        <option value="vencida">Vencida</option>
                        <option value="alerta">Com alerta</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="button"
                            id="btnLimparFiltros"
                            class="btn btn-outline-secondary w-100">
                        Limpar filtros
                    </button>
                </div>

            </div>

            <div class="mt-3">
                <small class="text-muted">
                    Exibindo
                    <strong id="contadorExibidas">@Model.Count()</strong>
                    de
                    <strong id="contadorTotal">@Model.Count()</strong>
                    viaturas
                </small>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Prefixo</th>
                            <th>Placa</th>
                            <th>Modelo</th>
                            <th>Tipo</th>
                            <th>Seção</th>
                            <th>Responsável</th>
                            <th>KM Atual</th>
                            <th>KM Ult. Abast.</th>
                            <th>Revisão</th>
                            <th>Situação</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyViaturas">

                        @foreach (var viatura in Model)
                        {
                            var responsavel = "";

                            if (viatura.OperadorResponsavel != null)
                            {
                                responsavel =
                                $"{viatura.OperadorResponsavel.NumericaDOE} {viatura.OperadorResponsavel.Alcunha}";
                            }

                            var textoPesquisa =
                            $"{viatura.Prefixo} " +
                            $"{viatura.Placa} " +
                            $"{viatura.Modelo} " +
                            $"{responsavel}";

                            int? kmRestanteRevisao = viatura.KmProximaRevisao.HasValue
                            ? viatura.KmProximaRevisao.Value - viatura.KmAtual
                            : (int?)null;

                            var statusRevisao = "normal";

                            if (kmRestanteRevisao.HasValue && kmRestanteRevisao.Value <= 0)
                            {
                                statusRevisao = "vencida";
                            }
                            else if (kmRestanteRevisao.HasValue &&
                            kmRestanteRevisao.Value <= limiteAlertaRevisao)
                            {
                                statusRevisao = "proxima";
                            }

                            <tr class="linha-viatura @(statusRevisao == "vencida" ? "table-danger" : statusRevisao == "proxima" ? "table-warning" : "")"
                                data-texto="@textoPesquisa.ToLower()"
                                data-secao="@viatura.SessaoID"
                                data-tipo="@((int)viatura.TipoCaracterizacao)"
                                data-situacao="@((int)viatura.Situacao)"
                                data-revisao="@statusRevisao">

                                <td>
                                    <strong>@viatura.Prefixo</strong>
                                </td>

                                <td>
                                    @viatura.Placa
                                </td>

                                <td>
                                    @viatura.Modelo
                                </td>

                                <td>
                                    @if (viatura.TipoCaracterizacao ==
                                                                    XTipoCaracterizacaoViatura.Caracterizada)
                                    {
                                        <span>Caracterizada</span>
                                    }
                                    else if (viatura.TipoCaracterizacao ==
                                    XTipoCaracterizacaoViatura.Descaracterizada)
                                    {
                                        <span>Descaracterizada</span>
                                    }
                                    else
                                    {
                                        <span>@viatura.TipoCaracterizacao</span>
                                    }
                                </td>

                                <td>
                                    @viatura.Sessao?.Nome
                                </td>

                                <td>
                                    @if (viatura.OperadorResponsavel != null)
                                    {
                                        <span>
                                            @viatura.OperadorResponsavel.NumericaDOE -
                                            @viatura.OperadorResponsavel.Alcunha
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Não definido
                                        </span>
                                    }
                                </td>

                                <td>
                                    @viatura.KmAtual.ToString("N0")
                                </td>

                                <td>
                                    @if (viatura.KmUltimoAbastecimento != null
                                                                    && viatura.KmUltimoAbastecimento > 0)
                                    {
                                        @viatura.KmUltimoAbastecimento.Value.ToString("N0")
                                    }
                                </td>

                                <td class="text-nowrap">
                                    @if (!viatura.KmProximaRevisao.HasValue)
                                    {
                                        <span class="text-muted">Não informada</span>
                                    }
                                    else if (statusRevisao == "vencida")
                                    {
                                        <span class="badge bg-danger">
                                            Vencida há @Math.Abs(kmRestanteRevisao!.Value).ToString("N0") km
                                        </span>
                                    }
                                    else if (statusRevisao == "proxima")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Em @kmRestanteRevisao!.Value.ToString("N0") km
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @viatura.KmProximaRevisao.Value.ToString("N0") km
                                        </span>
                                    }
                                </td>

                                <td>

                                    @if (viatura.Situacao == XSituacaoViatura.Disponivel)
                                    {
                                        <span class="badge bg-success">
                                            Disponível
                                        </span>
                                    }
                                    else if (viatura.Situacao ==
                                    XSituacaoViatura.EmUso)
                                    {
                                        <span class="badge bg-primary">
                                            Em uso
                                        </span>
                                    }
                                    else if (viatura.Situacao ==
                                    XSituacaoViatura.Manutencao)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Manutenção
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Indisponível
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (viatura.Situacao ==
                                                                    XSituacaoViatura.Disponivel)
                                    {
                                        <a asp-action="Retirar"
                                           asp-route-pViaturaID="@viatura.ID"
                                           class="btn btn-sm btn-primary">
                                            Retirar
                                        </a>
                                    }

                                    @if (viatura.Situacao ==
                                                                    XSituacaoViatura.EmUso)
                                    {
                                        <a asp-action="Devolver"
                                           asp-route-pViaturaID="@viatura.ID"
                                           class="btn btn-sm btn-success">
                                            Devolver
                                        </a>
                                    }

                                    <a asp-action="ExibirHistorico"
                                       asp-route-pViaturaID="@viatura.ID"
                                       class="btn btn-sm btn-outline-secondary">
                                        Histórico
                                    </a>

                                </td>

                            </tr>
                        }

                        <tr id="linhaSemResultados"
                            style="display:none;">
                            <td colspan="11"
                                class="text-center text-muted py-4">
                                Nenhuma viatura encontrada para os filtros informados.
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            const filtroTexto =
                document.getElementById('filtroTexto');

            const filtroSecao =
                document.getElementById('filtroSecao');

            const filtroTipo =
                document.getElementById('filtroTipo');

            const filtroSituacao =
                document.getElementById('filtroSituacao');

            const filtroRevisao =
                document.getElementById('filtroRevisao');

            const btnVerAlertasRevisao =
                document.getElementById('btnVerAlertasRevisao');

            const botoesFiltroRevisao =
                document.querySelectorAll('.btn-filtro-revisao');

            const btnLimparFiltros =
                document.getElementById('btnLimparFiltros');

            const contadorExibidas =
                document.getElementById('contadorExibidas');

            const linhaSemResultados =
                document.getElementById('linhaSemResultados');

            const linhas =
                Array.from(
                    document.querySelectorAll('.linha-viatura')
                );

            function normalizarTexto(texto) {

                return (texto || '')
                    .toString()
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '');
            }

            function aplicarFiltros() {

                const texto =
                    normalizarTexto(filtroTexto.value);

                const secao =
                    filtroSecao.value;

                const tipo =
                    filtroTipo.value;

                const situacao =
                    filtroSituacao.value;

                const revisao =
                    filtroRevisao.value;

                let exibidas = 0;

                linhas.forEach(function (linha) {

                    const textoLinha =
                        normalizarTexto(
                            linha.dataset.texto
                        );

                    const secaoLinha =
                        linha.dataset.secao || '';

                    const tipoLinha =
                        linha.dataset.tipo || '';

                    const situacaoLinha =
                        linha.dataset.situacao || '';

                    const revisaoLinha =
                        linha.dataset.revisao || 'normal';

                    const matchTexto =
                        !texto ||
                        textoLinha.includes(texto);

                    const matchSecao =
                        !secao ||
                        secao === secaoLinha;

                    const matchTipo =
                        !tipo ||
                        tipo === tipoLinha;

                    const matchSituacao =
                        !situacao ||
                        situacao === situacaoLinha;

                    const matchRevisao =
                        !revisao ||
                        revisao === revisaoLinha ||
                        (revisao === 'alerta' &&
                         (revisaoLinha === 'proxima' ||
                          revisaoLinha === 'vencida'));

                    const exibir =
                        matchTexto &&
                        matchSecao &&
                        matchTipo &&
                        matchSituacao &&
                        matchRevisao;

                    linha.style.display =
                        exibir ? '' : 'none';

                    if (exibir) {
                        exibidas++;
                    }
                });

                contadorExibidas.textContent =
                    exibidas;

                if (linhaSemResultados) {
                    linhaSemResultados.style.display =
                        exibidas === 0
                            ? ''
                            : 'none';
                }
            }

            function aplicarFiltroRevisao(valor) {

                filtroRevisao.value = valor;
                aplicarFiltros();

                const tabela =
                    document.getElementById('tbodyViaturas');

                if (tabela) {
                    tabela.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            }

            filtroTexto.addEventListener(
                'input',
                aplicarFiltros
            );

            filtroSecao.addEventListener(
                'change',
                aplicarFiltros
            );

            filtroTipo.addEventListener(
                'change',
                aplicarFiltros
            );

            filtroSituacao.addEventListener(
                'change',
                aplicarFiltros
            );

            filtroRevisao.addEventListener(
                'change',
                aplicarFiltros
            );

            if (btnVerAlertasRevisao) {
                btnVerAlertasRevisao.addEventListener(
                    'click',
                    function () {
                        aplicarFiltroRevisao('alerta');
                    }
                );
            }

            botoesFiltroRevisao.forEach(function (botao) {
                botao.addEventListener(
                    'click',
                    function () {
                        aplicarFiltroRevisao(
                            botao.dataset.revisao
                        );
                    }
                );
            });

            btnLimparFiltros.addEventListener(
                'click',
                function () {

                    filtroTexto.value = '';
                    filtroSecao.value = '';
                    filtroTipo.value = '';
                    filtroSituacao.value = '';
                    filtroRevisao.value = '';

                    aplicarFiltros();

                    // Remove o parâmetro da URL sem recarregar a página.
                    if (window.history.replaceState) {
                        window.history.replaceState(
                            {},
                            document.title,
                            window.location.pathname
                        );
                    }

                    filtroTexto.focus();
                }
            );

            /*
             * Permite abrir esta tela já filtrada:
             * /Viatura/Listar?revisao=alerta
             * /Viatura/Listar?revisao=proxima
             * /Viatura/Listar?revisao=vencida
             */
            const parametrosUrl =
                new URLSearchParams(window.location.search);

            const revisaoUrl =
                parametrosUrl.get('revisao');

            const filtrosRevisaoValidos =
                ['normal', 'proxima', 'vencida', 'alerta'];

            if (revisaoUrl &&
                filtrosRevisaoValidos.includes(revisaoUrl)) {

                filtroRevisao.value = revisaoUrl;
            }

            aplicarFiltros();
        });

    </script>
}
