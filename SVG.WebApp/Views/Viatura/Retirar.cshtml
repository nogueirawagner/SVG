@model SVG.WebApp.Models.ViaturaRetiradaViewModel

@{
    Layout = "_LayoutOperador";
    ViewData["Title"] = "Retirar Viatura";

    var operadoresJson = (string)(ViewBag.OperadoresJson ?? "[]");

    const int limiteAlertaRevisao = 2800;

    int? kmRestanteRevisao = Model.KmProximaRevisao.HasValue
        ? Model.KmProximaRevisao.Value - Model.KmAtual
        : (int?)null;
}

<div class="container mt-4" style="max-width: 700px;">

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Retirada de Viatura
            </h5>
        </div>

        <div class="card-body">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-4">

                <h4>
                    @Model.Prefixo
                </h4>

                <div class="text-muted">
                    @Model.Modelo
                    |
                    @Model.Placa
                </div>

                <div class="text-muted">
                    Seção: @Model.Secao
                </div>

                <div class="text-muted">
                    KM atual:
                    @Model.KmAtual.ToString("N0")
                </div>

            </div>

            @if (kmRestanteRevisao.HasValue && kmRestanteRevisao.Value <= 0)
            {
                <div class="alert alert-danger shadow-sm">
                    <strong>⚠ Revisão vencida</strong><br />
                    Esta viatura ultrapassou a quilometragem da próxima revisão em
                    <strong>@Math.Abs(kmRestanteRevisao.Value).ToString("N0") km</strong>.
                    Próxima revisão cadastrada:
                    <strong>@Model.KmProximaRevisao!.Value.ToString("N0") km</strong>.
                </div>
            }
            else if (kmRestanteRevisao.HasValue &&
            kmRestanteRevisao.Value <= limiteAlertaRevisao)
            {
                <div class="alert alert-warning shadow-sm">
                    <strong>⚠ Atenção à revisão</strong><br />
                    Faltam apenas
                    <strong>@kmRestanteRevisao.Value.ToString("N0") km</strong>
                    para a próxima revisão desta viatura.
                    Revisão prevista em
                    <strong>@Model.KmProximaRevisao!.Value.ToString("N0") km</strong>.
                </div>
            }

            <form asp-action="Retirar"
                  method="post"
                  id="formRetirada">

                @Html.AntiForgeryToken()

                <input asp-for="ViaturaID"
                       type="hidden" />

                <input asp-for="Prefixo"
                       type="hidden" />

                <input asp-for="Placa"
                       type="hidden" />

                <input asp-for="Modelo"
                       type="hidden" />

                <input asp-for="Secao"
                       type="hidden" />

                <input asp-for="KmAtual"
                       type="hidden" />

                <input asp-for="KmProximaRevisao"
                       type="hidden" />

                <input asp-for="OperadorID"
                       type="hidden"
                       id="OperadorID" />

                <input asp-for="OperadorNome"
                       type="hidden"
                       id="OperadorNome" />

                <!-- OPERADOR -->
                <div class="mb-3">

                    <label class="form-label">
                        Operador
                    </label>

                    <input type="text"
                           id="pesquisaOperador"
                           class="form-control"
                           value="@Model.OperadorNome"
                           placeholder="Digite o nome, alcunha ou numérica..."
                           autocomplete="off" />

                    <div id="resultadoOperadores"
                         class="list-group mt-1"
                         style="display:none; max-height:250px; overflow-y:auto;">
                    </div>

                    <span asp-validation-for="OperadorID"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        O operador logado é selecionado automaticamente.
                        Para alterar, pesquise outro operador.
                    </div>

                </div>

                <!-- FINALIDADE -->
                <div class="mb-3">

                    <label asp-for="Finalidade"
                           class="form-label">
                        Finalidade
                    </label>

                    <select asp-for="Finalidade"
                            asp-items="Html.GetEnumSelectList<SVG.Domain.TiposEstruturados.Enums.XFinalidadeViatura>()"
                            class="form-select">
                    </select>

                </div>

                <!-- OBSERVAÇÃO -->
                <div class="mb-3">

                    <label asp-for="Observacao"
                           class="form-label">
                        Observação
                        <span class="text-muted">
                            (opcional)
                        </span>
                    </label>

                    <textarea asp-for="Observacao"
                              class="form-control"
                              rows="3"
                              placeholder="Observações sobre a retirada, se necessário."></textarea>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Listar"
                       class="btn btn-secondary">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Confirmar Retirada
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const operadores = @Html.Raw(operadoresJson);

        const pesquisa = document.getElementById('pesquisaOperador');
        const resultado = document.getElementById('resultadoOperadores');
        const operadorID = document.getElementById('OperadorID');
        const operadorNome = document.getElementById('OperadorNome');
        const form = document.getElementById('formRetirada');

        function normalizarTexto(texto) {

            return (texto || '')
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim();
        }

        function esconderResultados() {

            resultado.innerHTML = '';
            resultado.style.display = 'none';
        }

        function selecionarOperador(operador) {

            operadorID.value = operador.id;
            operadorNome.value = operador.descricao;

            pesquisa.value = operador.descricao;

            esconderResultados();
        }

        pesquisa.addEventListener('input', function () {

            const termo = normalizarTexto(this.value);

            /*
             * Se o usuário começou a alterar o texto,
             * a seleção anterior deixa de ser válida.
             */
            operadorID.value = '';
            operadorNome.value = '';

            resultado.innerHTML = '';

            if (!termo) {
                esconderResultados();
                return;
            }

            const filtrados = operadores
                .filter(function (operador) {

                    const nome = normalizarTexto(operador.nome);
                    const alcunha = normalizarTexto(operador.alcunha);
                    const numerica = normalizarTexto(operador.numerica);
                    const descricao = normalizarTexto(operador.descricao);

                    return nome.includes(termo)
                        || alcunha.includes(termo)
                        || numerica.includes(termo)
                        || descricao.includes(termo);
                })
                .slice(0, 15);

            if (filtrados.length === 0) {

                resultado.innerHTML =
                    '<div class="list-group-item text-muted">' +
                        'Nenhum operador encontrado.' +
                    '</div>';

                resultado.style.display = 'block';

                return;
            }

            filtrados.forEach(function (operador) {

                const item = document.createElement('button');

                item.type = 'button';
                item.className =
                    'list-group-item list-group-item-action';

                item.textContent = operador.descricao;

                item.addEventListener('click', function () {
                    selecionarOperador(operador);
                });

                resultado.appendChild(item);
            });

            resultado.style.display = 'block';
        });

        pesquisa.addEventListener('focus', function () {

            if (this.value.trim() !== '')
                this.select();
        });

        document.addEventListener('click', function (event) {

            if (!pesquisa.contains(event.target) &&
                !resultado.contains(event.target)) {

                esconderResultados();
            }
        });

        form.addEventListener('submit', function (event) {

            if (!operadorID.value ||
                parseInt(operadorID.value) <= 0) {

                event.preventDefault();

                alert('Selecione um operador na pesquisa.');

                pesquisa.focus();
            }
        });

    </script>

}