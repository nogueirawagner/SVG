@using SVG.Domain.Entities
@using SVG.Domain.TiposEstruturados.Enums

@model IEnumerable<ViaturaMovimentacao>

@{
    Layout = "_LayoutOperador";
    ViewData["Title"] = "Histórico da Viatura";

    var viatura = (Viatura)ViewBag.Viatura;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="mb-0">
                Histórico - @viatura.Prefixo
            </h3>

            <small class="text-muted">
                @viatura.Modelo | @viatura.Placa
            </small>

        </div>

        <a asp-action="Listar"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Data/Hora</th>
                            <th>Situação</th>
                            <th>Operador</th>
                            <th>Finalidade</th>
                            <th>KM Inicial</th>
                            <th>KM Final</th>
                            <th>Abastecimento</th>
                            <th>KM Abastec.</th>
                            <th>Próx. Revisão</th>
                            <th>Observação</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var movimentacao in Model)
                        {
                            <tr>

                                <!-- DATA/HORA -->
                                <td class="text-nowrap">
                                    @movimentacao.DataHora.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- SITUAÇÃO -->
                                <td>

                                    @if (movimentacao.Situacao == XSituacaoViatura.EmUso)
                                    {
                                        <span class="badge bg-primary">
                                            Retirada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Devolução
                                        </span>
                                    }

                                </td>

                                <!-- OPERADOR -->
                                <td class="text-nowrap">

                                    @if (movimentacao.Operador != null)
                                    {
                                        <span>
                                            @movimentacao.Operador.NumericaDOE -
                                            @movimentacao.Operador.Alcunha
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- FINALIDADE -->
                                <td>
                                    @movimentacao.Finalidade
                                </td>

                                <!-- KM INICIAL -->
                                <td class="text-nowrap">

                                    @if (movimentacao.KmInicial > 0)
                                    {
                                        @movimentacao.KmInicial.ToString("N0")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- KM FINAL -->
                                <td class="text-nowrap">

                                    @if (movimentacao.KmFinal.HasValue)
                                    {
                                        @movimentacao.KmFinal.Value.ToString("N0")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- ABASTECIMENTO -->
                                <td>

                                    @if (movimentacao.Abastecimento)
                                    {
                                        <span class="badge bg-success">
                                            Sim
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Não
                                        </span>
                                    }

                                </td>

                                <!-- KM ABASTECIMENTO -->
                                <td class="text-nowrap">

                                    @if (movimentacao.Abastecimento &&
                                                                    movimentacao.KmAbastecimento.HasValue)
                                    {
                                        @movimentacao.KmAbastecimento.Value.ToString("N0")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- KM PROXIMA REVISÃO -->
                                <td class="text-nowrap">

                                    @if (viatura.KmProximaRevisao > 0)
                                    {
                                        @viatura.KmProximaRevisao.Value.ToString("N0")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- OBSERVAÇÃO -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(movimentacao.Observacao))
                                    {
                                        @movimentacao.Observacao
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>